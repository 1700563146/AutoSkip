    <!-- Whitelist -->
    <string name="whitelist_intro">白名单为占位功能：开关会持久化保存，但当前版本尚未根据白名单分发规则，所有未被显式禁用的应用都会使用同一套内置规则。</string>
    <string name="whitelist_empty">未找到可显示的应用</string>
    <string name="whitelist_loading">正在读取应用列表…</string>
    <string name="action_reload">刷新</string>

    <!-- Test mode -->
    <string name="test_mode_intro">开启后，屏幕上会随机位置浮出一个「跳过」按钮用来验证自动点击。它由无障碍服务识别并点击，点中即消失，随后在新位置重新出现。</string>
    <string name="test_mode_need_overlay">需要先授予悬浮窗权限</string>
    <string name="test_mode_need_a11y">需要先开启无障碍服务</string>
    <string name="action_start_test">开始测试</string>
    <string name="action_stop_test">停止测试</string>
    <string name="label_test_interval">弹出间隔</string>
    <string name="label_test_interval_hint">按钮被点掉后，隔多久在新位置重新出现。</string>
    <!--
      "自动命中" is counted by the accessibility service itself, so tapping the
      button by hand dismisses it without inflating the hit count: 弹出 may then
      exceed 自动命中, which correctly means the service was not the one that
      clicked it.
    -->
    <string name="test_stats_format">弹出 %1$d 次 · 自动命中 %2$d 次</string>
    <string name="test_hit_rate">命中率 %1$d%%</string>
